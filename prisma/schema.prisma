generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Enquiry {
  id           String        @id @default(cuid())
  name         String
  phone        String
  email        String
  projectType  String?
  budget       String?
  location     String?
  notes        String?
  followUpDate DateTime?
  assignedTo   String?
  message      String
  source       EnquirySource @default(CONTACT_PAGE)
  serviceSlug  String?
  projectSlug  String?
  status       EnquiryStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relation to quotations (admin-only module)
  quotations Quotation[]

  @@index([status])
  @@index([createdAt])
}

model Service {
  id               String               @id @default(cuid())
  slug             String               @unique
  name             String
  shortDescription String
  description      String
  icon             String               @default("compass")
  coverImage       String?
  order            Int                  @default(0)
  published        Boolean              @default(true)
  features         String[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  faqs             ServiceFaq[]
  images           ServiceImage[]
  processSteps     ServiceProcessStep[]
}

model ServiceProcessStep {
  id          String  @id @default(cuid())
  serviceId   String
  order       Int
  title       String
  description String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceFaq {
  id        String  @id @default(cuid())
  serviceId String
  order     Int     @default(0)
  question  String
  answer    String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceImage {
  id        String  @id @default(cuid())
  serviceId String
  url       String
  order     Int     @default(0)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Project {
  id               String                @id @default(cuid())
  slug             String                @unique
  name             String
  category         ProjectCategory
  projectType      String
  client           String?
  location         String
  area             String
  timeline         String
  year             String
  status           ProjectStatus         @default(COMPLETED)
  coverImage       String?
  description      String
  challenges       String?
  solutions        String?
  materialsUsed    String[]              @default([])
  highlights       String[]              @default([])
  featured         Boolean               @default(false)
  published        Boolean               @default(true)
  order            Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  beforeAfterPairs ProjectBeforeAfter[]
  images           ProjectImage[]
  timelineSteps    ProjectTimelineStep[]
  videos           ProjectVideo[]

  @@index([category])
  @@index([featured])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  url       String
  order     Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectVideo {
  id        String  @id @default(cuid())
  projectId String
  url       String
  title     String?
  order     Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectTimelineStep {
  id          String  @id @default(cuid())
  projectId   String
  order       Int
  label       String
  date        String?
  description String?
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectBeforeAfter {
  id        String  @id @default(cuid())
  projectId String
  beforeUrl String
  afterUrl  String
  order     Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model GalleryItem {
  id        String           @id @default(cuid())
  type      GalleryMediaType
  url       String
  title     String?
  category  String?
  order     Int              @default(0)
  createdAt DateTime         @default(now())
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  role        String
  location    String
  quote       String
  rating      Int      @default(5)
  projectSlug String?
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Faq {
  id        String  @id @default(cuid())
  category  String
  question  String
  answer    String
  order     Int     @default(0)
  published Boolean @default(true)
}

model SiteStat {
  id     String @id @default(cuid())
  key    String @unique
  label  String
  value  Int
  suffix String @default("")
}

enum EnquiryStatus {
  PENDING
  NEW
  CONTACTED
  SITE_VISIT_SCHEDULED
  QUOTATION_SENT
  WON
  LOST
}

enum EnquirySource {
  CONTACT_PAGE
  SERVICE_PAGE
  PROJECT_PAGE
}

enum ProjectCategory {
  RESIDENTIAL
  COMMERCIAL
  INTERIOR
  RENOVATION
}

enum ProjectStatus {
  COMPLETED
  ONGOING
}

enum GalleryMediaType {
  PHOTO
  VIDEO
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

model Quotation {
  id              String          @id @default(cuid())
  enquiryId       String
  quotationNumber String          @unique
  clientName      String
  projectType     String?
  location        String?
  validUntil      DateTime?
  subtotal        Float           @default(0)
  discount        Float           @default(0)
  gst             Float           @default(0)
  total           Float           @default(0)
  notes           String?
  status          QuotationStatus @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  enquiry Enquiry         @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  items   QuotationItem[]

  @@index([quotationNumber])
  @@index([status])
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  description String
  quantity    Float   @default(1)
  unit        String?
  rate        Float   @default(0)
  amount      Float   @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}
